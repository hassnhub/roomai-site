# Copy to .env and adjust.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=roomai

# Use a long random value in production, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Fernet key for encrypting uploaded photos. Leave blank to auto-generate into .storage_key
STORAGE_KEY=

# Visualisation: auto | stability | replicate | local
VISUALISER=auto
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL=adirik/interior-design

# Google Sign-In: OAuth 2.0 Web client ID (authorised origin http://localhost:5173)
GOOGLE_CLIENT_ID=
